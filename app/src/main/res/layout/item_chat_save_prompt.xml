<?xml version="1.0" encoding="utf-8"?>
<!--
    item_chat_save_prompt.xml
    Used by ChatAdapter when the AI returns a structured itinerary (Day 1…).
    Shows the AI text bubble PLUS a teal "Save as Trip →" action button below it.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:layout_marginBottom="12dp">

    <!-- AI bubble row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start">

        <!-- AI Avatar -->
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✦"
            android:textColor="#2E6B2E"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"/>

        <!-- AI message text -->
        <TextView
            android:id="@+id/tvAiMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_ai_bubble"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="#DDDDDD"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"/>
    </LinearLayout>

    <!-- Save as Trip button — below the bubble, indented to align with text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginStart="40dp">

        <TextView
            android:id="@+id/btnSaveTrip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="💾  Save as Trip →"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/bg_category_chip_selected"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>
